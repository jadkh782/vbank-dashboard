# services/ingest — runs on the VPN-connected machine. Never commit the real file.
ORCH_URL=https://asvbank17.v-bank.com
IDENTITY_URL=https://asvbank17.v-bank.com/identity
TENANT=Default
# Quote the secret: it contains '#'.
CLIENT_ID="…"
CLIENT_SECRET="…"
SCOPES=OR.Jobs.Read OR.Queues.Read OR.Folders.Read OR.Monitoring.Read OR.Execution.Read
# Internal CA / self-signed certificate only (dev): true skips TLS verification.
TLS_INSECURE=

SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key: bypasses RLS. Only here, never in an app.
SUPABASE_SERVICE_ROLE_KEY=

# Behaviour
LOOKBACK_DAYS=3
DAILY_AT=02:00
POLL_MS=30000
FOLDER_CONCURRENCY=5
