{
  "name": "vbank-dashboard",
  "private": true,
  "version": "2.0.0",
  "description": "Exelentic – V-Bank · automation status: dashboard, control board, ingest",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/dashboard",
    "dev:cb": "npm run dev -w apps/control-board",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "ingest": "npm run ingest -w services/ingest --",
    "serve": "npm run serve -w apps/dashboard",
    "deploy:demo": "node scripts/deploy-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
