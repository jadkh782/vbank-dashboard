# Automatisierung bei der V-Bank · Statusbericht (apps/dashboard)
# Copy to .env. Only the Supabase anon key lives here; it is public by design,
# row-level security decides what a logged-in user may read.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Demo build (no login, no database): the Vercel project `vbank-dashboard-demo`
# sets this to true. The production build leaves it empty; `?demo` in the URL
# still works for a quick look, `?live` forces the real connection.
VITE_DEMO_DEFAULT=
