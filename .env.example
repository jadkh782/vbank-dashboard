# ── Exelentic – Vbank · Intelligent Analysis Dashboard ─────────────────────
# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# stays on this machine only. Test the connection with:  npm run check

# ══ Where is Orchestrator? — fill in EITHER section 1 OR section 2 ═════════

# ── 1. UiPath Automation Cloud ─────────────────────────────────────────────
# Organization and tenant names exactly as they appear in the URL:
# https://cloud.uipath.com/{ORG}/{TENANT}/...
VITE_UIPATH_ORG=
VITE_UIPATH_TENANT=
# Only change this for sovereign clouds (e.g. https://alpha.uipath.com).
VITE_UIPATH_BASE_URL=https://cloud.uipath.com

# ── 2. Self-hosted Orchestrator (on-premises / Automation Suite, e.g. only
#       reachable through the Barracuda VPN) ──────────────────────────────
# The dev-server proxy runs on this machine, so it reaches Orchestrator as
# soon as the VPN client is connected here. Leave empty for Automation Cloud.
#
#   Standalone Orchestrator:  ORCHESTRATOR_URL=https://orchestrator.vbank.local
#                             IDENTITY_URL=https://orchestrator.vbank.local/identity
#   Automation Suite:         ORCHESTRATOR_URL=https://suite.vbank.local/{ORG}/{TENANT}/orchestrator_
#                             IDENTITY_URL=https://suite.vbank.local/identity_
VITE_UIPATH_ORCHESTRATOR_URL=
VITE_UIPATH_IDENTITY_URL=
# For standalone Orchestrator also set VITE_UIPATH_TENANT above (the tenant
# name shown top-right in Orchestrator, e.g. "Default"). It is sent as
# X-UIPATH-TenantName with every request.
#
# Internal CA / self-signed certificate: set to true to skip certificate
# verification (dev only). Better: import the CA into Windows and run
# `set NODE_EXTRA_CA_CERTS=C:\path\ca.pem` before `npm run dev`.
VITE_UIPATH_TLS_INSECURE=false

# ══ Credentials — EITHER Option A OR Option B ══════════════════════════════

# ── Option A: Personal Access Token ────────────────────────────────────────
# Automation Cloud → Preferences → Personal Access Tokens (cloud only).
# If set, this is used directly and Option B is ignored.
VITE_UIPATH_PAT=

# ── Option B: External Application (client credentials) ────────────────────
# Cloud:       Admin → External Applications → Add application (confidential)
# Self-hosted: https://<host>/identity/management → External Applications
# Grant these API scopes (APPLICATION scopes, not user scopes):
#   OR.Jobs.Read  OR.Queues.Read  OR.Folders.Read  OR.Monitoring.Read  OR.Execution.Read
# Put both values in double quotes — secrets often contain '#', which
# otherwise starts a comment and silently empties the value.
VITE_UIPATH_CLIENT_ID=""
VITE_UIPATH_CLIENT_SECRET=""

# Space-separated scopes requested with Option B. Must be a subset of the
# scopes granted to the External Application (remove any that were not granted).
VITE_UIPATH_SCOPES=OR.Jobs.Read OR.Queues.Read OR.Folders.Read OR.Monitoring.Read OR.Execution.Read

# ── Demo data by default ───────────────────────────────────────────────────
# Set to true on hosts that cannot reach Orchestrator (e.g. Vercel, when
# Orchestrator is only reachable through the VPN). ?live still forces the
# real connection, ?demo still forces demo data.
VITE_DEMO_DEFAULT=false

# ── Shared storage (Supabase) ──────────────────────────────────────────────
# Manual error entries and dashboard settings are shared between everyone who
# uses the dashboard via a free Supabase project:
#   1. Create a project at https://supabase.com (free tier is enough).
#   2. Run supabase/schema.sql in the project's SQL Editor.
#   3. Paste Project Settings → API → URL and anon public key here.
# If left empty, entries are stored in this browser only (not shared).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
